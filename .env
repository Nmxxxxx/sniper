# Скопируйте в .env. Файл .env в git не попадает.
# Стартовые значения стратегии (потом их можно менять прямо в панели):
MIN_DEV_BUY_SOL=0.5
MAX_DEV_BUY_SOL=5
BUY_SOL=1
TAKE_PROFIT_PCT=15
STOP_LOSS_PCT=-25
MAX_HOLD_SECONDS=120
FEE_PCT=1.0
MAX_OPEN_POSITIONS=5

# Окно наблюдения и обучение
ENTRY_DELAY_S=5
LEARNING_ENABLED=true
LEARNING_MIN_TRADES=30
MIN_EXPECTED_PCT=0
EXPLORE_PCT=15
BLACKLIST_LOSSES=2

# БЕСПЛАТНЫЙ источник данных: WebSocket-адрес Solana RPC, например от Helius:
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=ВАШ_КЛЮЧ
# Адрес содержит ваш ключ: не публикуйте его и не коммитьте .env
SOLANA_WS_URL=

# Альтернатива (платная): ключ PumpPortal для данных по сделкам (нужен кошелёк минимум с 0.02 SOL, см. README).
# Никогда не публикуйте его и не коммитьте файл .env
PUMPPORTAL_API_KEY=

# ИИ-оценка токенов через API DeepSeek (платный). Без ключа бот работает как раньше.
# Ключ нельзя публиковать и коммитить.
DEEPSEEK_API_KEY=

# Панель
WEB_PORT=8000
OPEN_BROWSER=true
